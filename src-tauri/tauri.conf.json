{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Biosketch Art Studio",
  "version": "3.1.3",
  "identifier": "art.biosketch.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Biosketch.Art Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["biosketch"],
        "name": "Biosketch.Art Studio Project",
        "description": "Biosketch.Art Studio project file",
        "role": "Editor",
        "mimeType": "application/x-biosketch"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
