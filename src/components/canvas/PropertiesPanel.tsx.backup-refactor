    setFreeformLineThickness(thickness);
    if (canvas && selectedObject && (selectedObject as any).isFreeformLine) {
      const pathObj = selectedObject as Path;
      pathObj.set({ strokeWidth: thickness });
      updateFreeformLineMarkers(
        pathObj,
        freeformStartMarker,
        freeformEndMarker,
        freeformLineColor,
        thickness
