                                    );
                                    canvas.add(updated);
                                    canvas.setActiveObject(updated);
                                    canvas.requestRenderAll();
                                  } catch (error) {
                                    console.error(
                                      "Failed to update position:",
                                      error
                                    );
                                    toast.error("Failed to update position");
                                  }
                                }
                              }}
                              min={0}
                              max={100}
                              step={5}
                              className="w-full"
                            />
                            <p className="text-xs text-muted-foreground">
                              {Math.round(
                                (getTextOnPathData(selectedObject)
                                  ?.alignmentOffset || 0) * 100
                              )}
                              %
                            </p>
                          </div>

                          <Button
                            variant="outline"
                            size="sm"
                            onClick={() => {
