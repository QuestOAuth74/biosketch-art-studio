                                      canvas.renderAll();

                                      toast.success("Manual erasure applied!");
                                    } catch (error) {
                                      console.error(
                                        "Failed to apply erased image:",
                                        error
                                      );
                                      toast.error("Failed to apply changes");
                                    }
                                  }}
                                />
                              </div>
                            </AccordionContent>
                          </AccordionItem>

                          {/* Image Filters */}
                          <AccordionItem
                            value="image-filters"
                            className="border-none"
                          >
                            <AccordionTrigger className="py-3 px-3 hover:bg-accent/50 rounded-lg hover:no-underline">
                              <span className="text-xs font-semibold uppercase tracking-wider">
                                Image Filters
                              </span>
                            </AccordionTrigger>
                            <AccordionContent className="px-3 pb-3 pt-1">
                              <ImageFiltersPanel />
                            </AccordionContent>
                          </AccordionItem>

                          {/* Scientific Color Maps */}
                          <AccordionItem
                            value="color-maps"
                            className="border-none"
                          >
                            <AccordionTrigger className="py-3 px-3 hover:bg-accent/50 rounded-lg hover:no-underline">
                              <span className="text-xs font-semibold uppercase tracking-wider">
                                Scientific Color Maps
                              </span>
                            </AccordionTrigger>
                            <AccordionContent className="px-3 pb-3 pt-1">
                              <ColorMapsPanel />
                            </AccordionContent>
                          </AccordionItem>
                        </Accordion>
                      )}

                    {/* Shape Colors - Only show for non-text, non-image objects */}
                    {selectedObject &&
                      selectedObject.type !== "textbox" &&
                      selectedObject.type !== "image" &&
                      !(selectedObject instanceof FabricImage) &&
                      !(selectedObject as any).isFreeformLine &&
                      (selectedObject.type !== "group" ||
                        isShapeWithTextGroup(selectedObject)) && (
                        <ShapePropertiesSection
                          fillColor={shapeFillColor}
                          strokeColor={shapeStrokeColor}
                          onFillChange={handleShapeFillColorChange}
                          onStrokeChange={handleShapeStrokeColorChange}
                          recentColors={recentColors}
                        />
                      )}

                    {/* Legend Visibility - Only show when a callout is selected */}
                    {selectedObject && isCallout(selectedObject) && (
                      <Accordion
                        type="single"
                        defaultValue="legend"
                        className="w-full mt-3 border-t pt-3"
                      >
                        <AccordionItem
                          value="legend"
                          className="border-none"
                        >
                          <AccordionTrigger className="py-3 px-3 hover:bg-accent/50 rounded-lg hover:no-underline">
                            <span className="text-xs font-semibold uppercase tracking-wider">
                              Legend
                            </span>
                          </AccordionTrigger>
                          <AccordionContent className="px-3 pb-3 pt-1">
                            <div className="flex items-center justify-between">
                              <Label className="text-sm">Show Legend</Label>
                              <Switch
                                checked={showLegend}
                                onCheckedChange={(checked) => {
                                  setShowLegend(checked);
                                  const legend = canvas
                                    ?.getObjects()
                                    .find(
                                      (obj) =>
                                        (obj as any).customType ===
                                        "callout-legend"
                                    );
                                  if (canvas) {
                                    // Store the preference on the canvas itself
                                    (canvas as any).legendHidden = !checked;

                                    if (legend) {
                                      // Set visibility and hidden flag on the legend object
                                      legend.set({ visible: checked });
                                      (legend as any).legendHidden = !checked;
                                      // Use renderAll() instead of requestRenderAll() to avoid triggering events
                                      canvas.renderAll();
                                    }
                                  }
                                }}
                              />
                            </div>
                          </AccordionContent>
                        </AccordionItem>
                      </Accordion>
                    )}

                    {/* Eraser Controls - Only show when eraser tool is active */}
                    {activeTool === "eraser" && (
                      <Accordion
                        type="single"
                        defaultValue="eraser"
                        className="w-full"
                      >
                        <AccordionItem
                          value="eraser"
                          className="border-none"
                        >
                          <AccordionTrigger className="py-3 px-3 hover:bg-accent/50 rounded-lg hover:no-underline">
                            <div className="flex items-center gap-2">
                              <EraserIcon className="h-4 w-4 text-primary" />
                              <span className="text-xs font-semibold uppercase tracking-wider">
                                Eraser
                              </span>
                            </div>
                          </AccordionTrigger>
                          <AccordionContent className="px-3 pb-3 pt-1">
                            <div className="space-y-2">
                              <div className="flex items-center justify-between">
                                <Label className="text-xs">Eraser Size</Label>
                                <span className="text-xs font-mono text-muted-foreground">
                                  {eraserWidth}px
                                </span>
                              </div>
                              <Slider
                                value={[eraserWidth]}
                                onValueChange={handleEraserWidthChange}
                                min={5}
                                max={100}
                                step={1}
                                className="w-full"
                              />
                              <p className="text-xs text-muted-foreground">
                                Adjust the size of the eraser brush
                              </p>
                            </div>
                          </AccordionContent>
                        </AccordionItem>
                      </Accordion>
                    )}
                  </TabsContent>
                </div>
              </Tabs>
            </ScrollArea>
          )}
        </>
      )}
    </div>
  );
};
