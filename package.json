    "db:use-prod": "npx tsx scripts/switch-supabase-env.ts prod",
    "test": "npm run test:database && npm run test:unit && npm run test:edge-functions && npm run test:e2e && npm run test:report",
    "test:all": "npm run test:database && npm run test:unit && npm run test:edge-functions && npm run test:e2e && npm run test:e2e:stress && npm run test:report",
    "test:prod": "npm run test:database:prod && npm run test:unit && npm run test:edge-functions && npm run test:e2e && npm run test:report",
    "test:database": "vitest run tests/database --no-file-parallelism --reporter=default --reporter=json --outputFile=./test-results/vitest-database.json",
    "test:database:prod": "vitest run tests/database --no-file-parallelism --exclude=**/seed-verification.test.ts --reporter=default --reporter=json --outputFile=./test-results/vitest-database.json",
    "test:unit": "vitest run tests/unit --reporter=default --reporter=json --outputFile=./test-results/vitest-unit.json",
    "test:algorithms": "vitest run tests/unit/algorithms --reporter=default --reporter=json --outputFile=./test-results/vitest-algorithms.json",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:milestone1": "vitest run tests/database",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:auth": "playwright test tests/e2e/auth",
    "test:e2e:canvas": "playwright test tests/e2e/canvas --project=chromium",
    "test:e2e:stress": "playwright test --config=playwright.stress.config.ts",
    "test:e2e:stress:prod": "STRESS_TEST_URL=https://science-canvas-creator.vercel.app playwright test --config=playwright.stress.config.ts",
    "test:e2e:stress:headed": "playwright test --project=stress --workers=1 --headed",
    "test:e2e:stress:debug": "playwright test --project=stress --workers=1 --debug",
    "test:e2e:diagnostics": "playwright test --project=diagnostics",
    "test:edge-functions": "vitest run tests/edge-functions --reporter=default --reporter=json --outputFile=./test-results/vitest-edge-functions.json",
    "test:edge-functions:send-email": "vitest run tests/edge-functions/send-email",
    "test:report": "npx tsx scripts/generate-test-report.ts",
    "migrate:thumbnails": "npx tsx scripts/migrate-icon-thumbnails-png.ts",
    "migrate:thumbnails:dry-run": "npx tsx scripts/migrate-icon-thumbnails-png.ts --dry-run",
    "logs:clear": "npx tsx scripts/clear-dev-logs.ts",
    "logs:analyze": "npx tsx scripts/analyze-dev-logs.ts",
